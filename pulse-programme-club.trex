<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.carrefour.analyticsfactory.pulse.programmeclub" extension-version="0.2.0">
    <default-locale>fr_FR</default-locale>
    <name resource-id="name"/>
    <description>Pulse · Programme Club : brief, analyse approfondie et dashboard régalien</description>
    <author name="Analytics Factory" email="hajar_el_ouazzani@carrefour.com" organization="Carrefour France" website="https://www.carrefour.fr"/>
    <min-api-version>1.4</min-api-version>
    <source-location>
      <url>https://haelouaz.github.io/pulse-tableau/pulse-programme-club.html</url>
    </source-location>
    <icon></icon>
    <permissions>
      <permission>full data</permission>
    </permissions>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="fr_FR">Pulse · Programme Club</text>
      <text locale="en_US">Pulse · Programme Club</text>
    </resource>
  </resources>
</manifest>
